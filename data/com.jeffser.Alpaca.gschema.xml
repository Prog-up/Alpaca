<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="alpaca">
	<schema id="com.jeffser.Alpaca" path="/com/jeffser/Alpaca/">
		<key name="default-width" type="i">
			<default>1300</default>
		</key>
		<key name="default-height" type="i">
			<default>800</default>
		</key>
		<key name="maximized" type="b">
			<default>false</default>
		</key>
	  <key name="hide-on-close" type="b">
			<default>false</default>
		</key>
	  <key name="powersaver-warning" type="b">
			<default>true</default>
		</key>
	  <key name="zoom" type="i">
			<default>100</default>
		</key>
	  <key name="stt-model" type="i">
			<default>1</default>
		</key>
	  <key name="stt-language" type="i">
			<default>0</default>
		</key>
	  <key name="stt-auto-send" type="b">
			<default>false</default>
		</key>
	  <key name="tts-model" type="i">
			<default>0</default>
		</key>
	  <key name="tts-speed" type="d">
      <default>1.2</default>
	  </key>
	  <key name="max-image-size" type="i">
			<default>240</default>
		</key>
	  <key name="tts-auto-dictate" type="b">
			<default>false</default>
		</key>
	  <key name="default-chat" type="s">
			<default>""</default>
		</key>
	  <key name="selected-instance" type="s">
			<default>""</default>
		</key>
	  <key name="regenerate-after-edit" type="b">
			<default>false</default>
		</key>
    <key name="queue-prompts" type="b">
      <default>false</default>
      <summary>Queue one message while generating</summary>
      <description>Keep one waiting message per chat, with a preview and controls to edit or clear it before the current response finishes.</description>
    </key>
    <key name="agent-mode" type="b">
      <default>false</default>
      <summary>Clarify, plan, and execute tasks with an Ollama model</summary>
    </key>
    <key name="agent-auto-start" type="b">
      <default>false</default>
      <summary>Start an agent plan automatically when requirements are clear</summary>
    </key>
    <key name="agent-max-calls" type="i">
      <range min="1" max="256"/>
      <default>32</default>
    </key>
    <key name="agent-max-seconds" type="i">
      <range min="30" max="7200"/>
      <default>900</default>
    </key>
    <key name="agent-working-directory" type="s">
      <default>''</default>
      <summary>Agent working directory on the configured terminal host</summary>
    </key>
	  <key name="show-model-manager-shortcut" type="b">
			<default>true</default>
		</key>
	  <key name="folder-search-mode" type="b">
			<default>false</default>
		</key>
	  <key name="ollama-managed-auto-check-update" type="b">
			<default>false</default>
		</key>

	  <key name="activity-mode" type="i">
	    <default>0</default>
	  </key>
    <key name="default-tool" type="i">
	    <default>0</default>
	  </key>
	  <key name="activity-webbrowser-query-url" type="s">
	    <default>"https://startpage.com/sp/search?query={}"</default>
	  </key>
	  <key name="activity-webbrowser-homepage-url" type="s">
	    <default>"https://startpage.com"</default>
	  </key>
	  <key name="activity-terminal-type" type="i">
	    <default>1</default>
	  </key>
	  <key name="activity-terminal-username" type="s">
      <default>""</default>
	  </key>
	  <key name="activity-terminal-ip" type="s">
	    <default>""</default>
	  </key>
    <key name="activity-terminal-auto-execute" type="b">
      <default>false</default>
      <summary>Execute terminal tool commands automatically</summary>
      <description>Run model-requested shell commands without showing the confirmation dialog.</description>
    </key>
	  <key name="activity-background-remover-model" type="i">
	    <default>0</default>
	  </key>
	</schema>
</schemalist>
