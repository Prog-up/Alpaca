using Gtk 4.0;
using Adw 1;

template $AlpacaGlobalFooter: Gtk.Box {
  spacing: 10;
  orientation: vertical;
  styles [
    "p10"
  ]

  $AlpacaAttachmentContainer attachment_container {}

  Gtk.Box agent_box {
    visible: false;
    orientation: vertical;
    spacing: 6;
    styles ["card", "p10"]
  }

  Gtk.Box prompt_queue_box {
    visible: false;
    orientation: vertical;
    spacing: 6;
    styles ["card", "p10"]

    Gtk.Box {
      spacing: 6;
      Gtk.Label {
        label: _("Queued Message");
        hexpand: true;
        xalign: 0;
        styles ["heading"]
      }
      Gtk.Button {
        label: _("Edit");
        tooltip-text: _("Move the queued message into the composer to edit it");
        clicked => $edit_queued_prompt();
        styles ["flat"]
      }
      Gtk.Button {
        label: _("Clear");
        clicked => $clear_prompt_queue();
        styles ["flat"]
      }
    }
    Gtk.ScrolledWindow {
      max-content-height: 120;
      propagate-natural-height: true;
      hscrollbar-policy: never;
      child: Gtk.Label prompt_queue_label {
        xalign: 0;
        wrap: true;
        wrap-mode: word_char;
        selectable: true;
      };
    }
  }

  Gtk.Box message_text_view_container {
    overflow: hidden;
    styles [
      "card"
    ]

    Gtk.ScrolledWindow {
      max-content-height: 150;
      propagate-natural-height: true;
      min-content-height: 1;
      styles [
        "undershoot-bottom"
      ]
      child: $AlpacaGlobalMessageTextView message_text_view {};
    }

    $AlpacaGlobalActionStack action_stack {
      sensitive: false;
    }
  }

  Adw.WrapBox wrap_box {
    child-spacing: 10;
    line-spacing: 10;
    justify-last-line: true;

    $AlpacaGlobalAttachmentButton attachment_button {}

    $AlpacaMicrophoneButton microphone_button {}

    Gtk.Button model_manager_shortcut {
      icon-name: "brain-augemnted-symbolic";
      valign: center;
      tooltip-text: _("Manage Models");
      action-name: "app.model_manager";
      styles [
        "circular"
      ]
    }

    $AlpacaTextModelSelector model_selector {
      hexpand: true;
      halign: start;
    }

    $AlpacaToolSelector tool_selector {}
  }
}
